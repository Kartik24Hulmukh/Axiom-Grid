{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom-Grid",
  "version": "0.1.0",
  "identifier": "dev.axiomgrid.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axiom-Grid",
        "width": 420,
        "height": 700,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "contentProtected": false,
        "focus": false,
        "x": 40,
        "y": 100
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
