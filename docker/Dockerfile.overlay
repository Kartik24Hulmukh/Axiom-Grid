# Axiom-Grid Overlay API - Production Image
# Serves the hardened FastAPI overlay (zero-egress deterministic extraction,
# ClassifiedMemoPack wedge, SEC-001..SEC-006 hardening, ops probes).
#
# SEC-006: this image FAILS CLOSED. Protected routes return 503 until you
# mount at least one API key at runtime (never bake keys into the image):
#   printf '%s\n' '<generated-key>' > /secure/axiom.keys
#   chmod 400 /secure/axiom.keys
#   docker run --rm -p 8765:8765 \
#     --mount type=bind,src=/secure/axiom.keys,dst=/run/secrets/axiom_api_keys,readonly \
#     -e AXIOM_API_KEYS_FILE=/run/secrets/axiom_api_keys axiom-grid
# Clients then send:  Authorization: Bearer <key>   (or X-API-Key: <key>)
# For a same-origin desktop/localhost sidecar set AXIOM_REQUIRE_AUTH=0.
#
# Build:   docker build -t axiom-grid -f docker/Dockerfile.overlay .
# Run:     docker run --rm -p 8765:8765 axiom-grid
# Probes:  curl localhost:8765/healthz   (liveness)
#          curl localhost:8765/readyz    (real pipeline readiness)
#          curl localhost:8765/metrics   (runtime counters)

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    KAIRO_GATEWAY_TEST_MODE=false \
    KAIRO_AIR_GAP=true \
    AXIOM_EXTRACTION_ISOLATION=process \
    AXIOM_MAX_UPLOAD_BYTES=2097152 \
    AXIOM_REQUIRE_AUTH=1 \
    AXIOM_RATE_LIMIT_PER_MIN=300 \
    AXIOM_RATE_LIMIT_PER_MIN_AUTH=3000 \
    AXIOM_EXTRACTION_WORKERS=2 \
    AXIOM_PIPELINE_CONCURRENCY=2 \
    AXIOM_EXTRACTION_QUEUE_DEPTH=4 \
    AXIOM_EVIDENCE_WORKERS=2 \
    AXIOM_INGEST_RSS_BYTES=268435456 \
    AXIOM_INGEST_CPU_SECONDS=25 \
    WEB_CONCURRENCY=1 \
    UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=40 \
    PYTHONPATH=/app

WORKDIR /app

# Direct dependencies are pinned; transitive resolution is not a hash-locked supply chain.
COPY docker/requirements-runtime.txt /app/docker/requirements-runtime.txt
COPY requirements-telemetry.txt /app/requirements-telemetry.txt
RUN pip install --no-cache-dir --requirement /app/docker/requirements-runtime.txt --requirement /app/requirements-telemetry.txt

# Non-root runtime user (defense in depth)
RUN useradd --create-home --uid 10001 axiom \
    && mkdir -p /var/lib/axiom/page_images \
    && chown -R axiom:axiom /var/lib/axiom
ENV AXIOM_STATE_DIR=/var/lib/axiom \
    OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf \
    OTEL_METRICS_EXPORTER=none \
    OTEL_LOGS_EXPORTER=none

COPY overlay/ /app/overlay/
COPY kernel/ /app/kernel/
COPY kairo/ /app/kairo/
COPY packs/ /app/packs/
COPY fixtures/wedge/ /app/fixtures/wedge/
COPY conftest.py /app/conftest.py

USER axiom

EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/readyz').status==200 else 1)"

# Provenance previews are worker-local: keep one worker until shared evidence
# storage and multi-worker source-link verification exist. No RPS guarantee.
CMD ["opentelemetry-instrument", "python3", "-m", "uvicorn", "overlay.server:app", "--host", "0.0.0.0", "--port", "8765", "--proxy-headers", "--timeout-keep-alive", "15", "--timeout-graceful-shutdown", "40", "--limit-concurrency", "128"]
